# ── Gmail OAuth 2.0 ────────────────────────────────────────────────────────────
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REDIRECT_URI=http://localhost:3001/api/auth/gmail/callback

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── Database ───────────────────────────────────────────────────────────────────
DB_PATH=./data/tracker.db

# ── Token encryption (generate a random 32-char string) ───────────────────────
TOKEN_ENCRYPTION_KEY=change_this_to_a_random_32char_secret!!

# ── Monitoring schedule (cron expressions) ────────────────────────────────────
GMAIL_SYNC_CRON=*/15 * * * *
PORTAL_VERIFY_CRON=0 */6 * * *
ANALYTICS_CRON=0 3 * * *

# ── Notifications ──────────────────────────────────────────────────────────────
NOTIFICATION_EMAIL_TO=

# ── Feature flags ─────────────────────────────────────────────────────────────
ENABLE_BROWSER_VERIFICATION=false

# ── Frontend URL (for CORS) ────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── Telegram job alerts (Settings → Telegram alerts) ─────────────────────────
# 1) In Telegram, message @BotFather: /newbot  → paste the token here
# 2) Press Start in your new bot, then click "Send test message" in Settings to get your chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
