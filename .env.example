# Copy to backend/.env for local use. On Render, set these in the service's Environment tab (see render.yaml).

# ── Google OAuth (Gmail read-only + sign-in) ──────────────────────────────────
GMAIL_CLIENT_ID=your_google_oauth_client_id
GMAIL_CLIENT_SECRET=your_google_oauth_client_secret
GMAIL_REDIRECT_URI=http://localhost:3001/api/auth/gmail/callback

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Database ───────────────────────────────────────────────────────────────────
# Neon (or any Postgres) connection string. Leave empty to use a local embedded
# database in backend/data/pglite (no setup needed).
DATABASE_URL=

# ── Secrets (each a long random string; never commit real values) ─────────────
TOKEN_ENCRYPTION_KEY=   # encrypts Gmail tokens; changing it forces everyone to sign in again
SESSION_SECRET=         # signs login cookies; at least 32 characters

# ── Gmail sync ─────────────────────────────────────────────────────────────────
GMAIL_SYNC_MINUTES=15

# ── Telegram alerts (one shared bot; each user connects in Settings) ──────────
# 1) In Telegram, message @BotFather: /newbot  → token + username here
# 2) After deploying, register the webhook once (see README → Telegram alerts)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ── Candidate portal checks (your own machine only, never on the hosted server) ─
ENABLE_PORTAL_CHECKS=false
